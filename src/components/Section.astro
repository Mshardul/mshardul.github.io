---
import "../styles/components/section.css";

interface Props {
  tone: 1 | 2 | 3 | 4;
  id?: string;
  heading?: string;
  link?: { label: string; href: string };
  reveal?: boolean;
}

const { tone, id, heading, link, reveal = false } = Astro.props;
---

<section class={`section section--tone-${tone}`} id={id}>
  <div class={`section__inner${reveal ? " reveal" : ""}`}>
    {heading && (
      <div class="section__head">
        <h2 class="heading heading--section">{heading}</h2>
        {link && <a class="section__link" href={link.href}>{link.label}</a>}
      </div>
    )}
    <slot />
  </div>
</section>