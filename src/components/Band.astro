---
import "../styles/components/band.css";

interface Props {
  heading: string;
  text?: string;
  /** Adds space above the actions when they wrap below a heading-only band. */
  spaced?: boolean;
}

const { heading, text, spaced = false } = Astro.props;
---

<div class="band">
  <div>
    <h2 class="heading heading--section">{heading}</h2>
    {text && <p class="band__text">{text}</p>}
  </div>
  <div class={`band__actions${spaced ? " band__actions--spaced" : ""}`}>
    <slot />
  </div>
</div>