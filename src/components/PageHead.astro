---
import "../styles/components/pagehead.css";
import "../styles/components/section.css";

interface Props {
  label?: string;
  lead?: string;
  /** Name of the current project, shown after the "Things I've built" breadcrumb link. */
  crumb?: string;
}

const { label, lead, crumb } = Astro.props;
---

<div class="page-head">
  {label && <p class="eyebrow">{label}</p>}
  <h1><slot /></h1>
  {lead && <p class="lead">{lead}</p>}
  {crumb && <div class="breadcrumb"><a href="/projects">Projects</a> / {crumb}</div>}
  <slot name="after" />
</div>
