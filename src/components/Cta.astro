---
// Bridge for the old pages: removed in port stage 3 when the pages use Button directly.
import Button from "./Button.astro";

interface Props {
  primary?: boolean;
  label: string;
  href?: string;
  mail?: boolean;
}

const { primary = false, label, href, mail = false } = Astro.props;
---

<Button {label} {href} {mail} subject={label} variant={primary ? "primary" : "ghost"} />
