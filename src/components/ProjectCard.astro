---
import "../styles/components/project-card.css";
import TagList from "./TagList.astro";
import type { Project } from "../content/projects.ts";

interface Props {
  project: Project;
  /** Heading level of the project name: 2 when no h2 precedes it, 3 under a section heading. */
  level?: 2 | 3;
}

const { project, level = 3 } = Astro.props;
const Heading = `h${level}` as "h2" | "h3";
---

<a class="project-card" href={`/projects/${project.slug}`}>
  <div class="project-card__shot"></div>
  <div class="project-card__body">
    <Heading class="heading heading--item">{project.name}</Heading>
    <p class="project-card__text">{project.pitch}</p>
    <TagList items={project.tags} />
  </div>
</a>
