---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHead from "../components/PageHead.astro";
import Button from "../components/Button.astro";
import ChipList from "../components/ChipList.astro";
import iconManifest from "../assets/tech-icons/manifest.json";
import { roles } from "../content/experience.ts";
import { education } from "../content/education.ts";
import { meta } from "../content/meta.ts";
import { hasResume, RESUME_URL } from "../lib/site.ts";
import "../styles/components/pagehead.css";
import "../styles/components/section.css";
import "../styles/components/row.css";
import "../styles/components/chip.css";
import "../styles/components/contact-band.css";

// Chip icons come from the manifest: each label maps to an icon file in src/assets/tech-icons.
const techIcon: Record<string, string> = Object.fromEntries(
  iconManifest.icons.map((e) => [e.label, e.file.replace(".svg", "")]),
);
---

<BaseLayout title={meta.experience.title} description={meta.experience.description} current="experience">
  <main id="main" tabindex="-1">
    <PageHead label="Experience" lead="Every role with the impact, the tech and the scope.">
      7+ years of leading and building.
      <Fragment slot="after">
        <div class="actions">
          {hasResume && <Button label="Download resume" href={RESUME_URL} download icon="download" />}
          <Button mail subject="Get in touch" label="Get in touch" icon="mail" variant="ghost" />
        </div>
      </Fragment>
    </PageHead>

    <section class="section section--soft">
      <div class="container">
        <div class="rows rows--light rows--loose rows--flush">
          {roles.map((role) => (
            <article class="row row--job">
              <div class="row__when">{role.start} &ndash; {role.end}</div>
              <div>
                <h3>{role.company}</h3>
                <p class="row__role">{role.title}</p>
                {role.scope && <p class="row__impact">{role.scope}</p>}
                <ul>
                  {role.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
                <dl class="stack">
                  {role.stack.map((group) => (
                    <>
                      <dt>{group.area}</dt>
                      <dd>
                        <ChipList
                          small
                          items={group.items.map((t) => ({ label: t, icon: techIcon[t] ?? "" }))}
                        />
                      </dd>
                    </>
                  ))}
                </dl>
              </div>
            </article>
          ))}
        </div>
        <p class="references">References available on request.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="eyebrow">Education</p>
        <h2>Where I studied.</h2>
        <div class="rows">
          {education.map((item) => (
            <div class="row row--education">
              <b>{item.degree}</b>
              <span>{item.institution}</span>
              <em>{item.years}</em>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-band" id="contact">
      <div class="container">
        <div>
          <h2>Let&rsquo;s talk about what you&rsquo;re building.</h2>
          <p>Hiring a lead or need a project built? Send a line about what you need.</p>
        </div>
        <div class="contact-band__actions">
          <Button mail subject="Get in touch" label="Get in touch" icon="mail" />
          {hasResume && (
            <Button label="Download resume" href={RESUME_URL} download icon="download" variant="ghost" />
          )}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
