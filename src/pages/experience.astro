---
import BaseLayout from "../layouts/BaseLayout.astro";
import Cta from "../components/Cta.astro";
import Band from "../components/Band.astro";
import PageHead from "../components/PageHead.astro";
import Section from "../components/Section.astro";
import TimelineRole from "../components/TimelineRole.astro";
import { roles } from "../content/experience.ts";
import { copy } from "../content/copy.ts";
import { meta } from "../content/meta.ts";
import { hasResume, RESUME_URL } from "../lib/site.ts";

const { headline } = copy.experience;
---

<BaseLayout title={meta.experience.title} description={meta.experience.description}>
  <main class="page-main">
    <PageHead label="Experience" lead={copy.experience.lead}>
      {headline.before}<span class="highlight">{headline.highlight}</span>{headline.after}
    </PageHead>

    <Section tone={2}>
      <div class="timeline">
        {roles.map((role) => (
          <TimelineRole {role} detail />
        ))}
      </div>
    </Section>

    <Section tone={3}>
      <Band heading="Like what you see?" spaced>
        {hasResume && <Cta primary label="Download resume" href={RESUME_URL} />}
        <Cta primary={!hasResume} label="Let's talk" mail />
      </Band>
    </Section>
  </main>
</BaseLayout>