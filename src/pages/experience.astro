---
import BaseLayout from "../layouts/BaseLayout.astro";
import Cta from "../components/Cta.astro";
import Band from "../components/Band.astro";
import PageHead from "../components/PageHead.astro";
import Section from "../components/Section.astro";
import TimelineRole from "../components/TimelineRole.astro";
import { roles } from "../content/experience.ts";
import { hasResume, RESUME_URL } from "../lib/site.ts";
---

<BaseLayout title="Experience — Shardul Lingwal" description="Every role with the impact, the tech and the scope. Claim-level detail only.">
  <main class="page-main">
    <PageHead label="Experience" lead="Every role with the impact, the tech and the scope. Claim-level detail only.">
      Ten years of <span class="highlight">leading</span> and building.
    </PageHead>

    <Section tone={2}>
      <div class="timeline">
        {roles.map((role) => (
          <TimelineRole {role} detail />
        ))}
      </div>
    </Section>

    <Section tone={3}>
      <Band heading="Like what you see?" spaced>
        {hasResume && <Cta primary label="Download resume" href={RESUME_URL} />}
        <Cta primary={!hasResume} label="Let's talk" mail />
      </Band>
    </Section>
  </main>
</BaseLayout>