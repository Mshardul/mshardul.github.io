---
import BaseLayout from "../layouts/BaseLayout.astro";
import Cta from "../components/Cta.astro";
import Card from "../components/Card.astro";
import Band from "../components/Band.astro";
import PageHead from "../components/PageHead.astro";
import Section from "../components/Section.astro";
import { meta } from "../content/meta.ts";
import "../styles/components/service.css";

const services = [
  { title: "Web apps", text: "One line on the kind of web products I build, from sites to full apps.", project: "jugnu" },
  { title: "Mobile & desktop", text: "One line on native Mac apps, downloads and mobile work.", project: "tools" },
  { title: "Chrome extensions", text: "One line on browser extensions I ship.", project: "tool-stack" },
  { title: "Open source", text: "One line on the tools and docs I maintain in the open.", project: "systemdesign-wiki" },
];

const engagements = [
  { title: "One-off project", text: "A defined build, from idea to launch." },
  { title: "Ongoing", text: "A longer relationship, building and improving over time." },
  { title: "Consulting", text: "Architecture, reviews and technical leadership." },
];
---

<BaseLayout title={meta.build.title} description={meta.build.description}>
  <main class="page-main">
    <PageHead label="Build with me" lead="From small tools to full products. Here is what I build and how we can work together.">
      Web, mobile, Mac and Chrome, <span class="highlight">built</span> properly.
      <Fragment slot="after">
        <div class="btn-row">
          <Cta primary label="Start a project" mail />
        </div>
      </Fragment>
    </PageHead>

    <Section tone={2} heading="What I build">
      <div class="svc">
        {services.map((service) => (
          <Card>
            <div class="icon"></div>
            <h3 class="heading heading--item">{service.title}</h3>
            <p>{service.text}</p>
            <a class="see" href={`/projects/${service.project}`}>
              See: {service.project} →
            </a>
          </Card>
        ))}
      </div>
    </Section>

    <Section tone={3} heading="How we can work">
      <div class="eng">
        {engagements.map((engagement) => (
          <Card>
            <b>{engagement.title}</b>
            <p>{engagement.text}</p>
          </Card>
        ))}
      </div>
    </Section>

    <Section tone={4}>
      <Band heading="Have something in mind?" text="Send a short note about what you want built.">
        <Cta primary label="Start a project" mail />
      </Band>
    </Section>
  </main>
</BaseLayout>