---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHead from "../components/PageHead.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import { meta } from "../content/meta.ts";
import "../styles/components/pagehead.css";
import "../styles/components/section.css";
import "../styles/components/row.css";
import "../styles/components/stats.css";
import "../styles/components/chip.css";
import "../styles/components/contact-band.css";
---

<BaseLayout title={meta.build.title} description={meta.build.description} current="build">
  <main id="main" tabindex="-1">
    <PageHead label="Build with me" lead="From small tools to full products. Here is what I build and how we can work together.">
      Web, mobile, Mac and Chrome, built properly.
      <Fragment slot="after">
        <div class="actions">
          <Button mail subject="Project" label="Get in touch" icon="mail" />
        </div>
      </Fragment>
    </PageHead>

    <section class="section">
      <div class="container">
        <p class="eyebrow">What I build</p>
        <h2>Things I can take on.</h2>
        <div class="rows">
          <div class="row row--build">
            <h3>Web apps</h3>
            <p>Live and open-source web products, with the backend done properly.</p>
            <a class="link-arrow" href="/coming-soon">jugnu<Icon name="arrow" /></a>
          </div>
          <div class="row row--build">
            <h3>Mac apps</h3>
            <p>Native desktop tools, shipped as downloads.</p>
            <a class="link-arrow" href="/coming-soon">Tools<Icon name="arrow" /></a>
          </div>
          <div class="row row--build">
            <h3>Chrome extensions</h3>
            <p>Browser tools that fit into how people already work.</p>
            <a class="link-arrow" href="/coming-soon">tool-stack<Icon name="arrow" /></a>
          </div>
          <div class="row row--build">
            <h3>Backend systems</h3>
            <p>Scheduling, ingestion and payments platforms, from architecture to production.</p>
            <a class="link-arrow" href="/experience">See: experience<Icon name="arrow" /></a>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--soft">
      <div class="container">
        <p class="eyebrow">How we can work</p>
        <h2>Three ways to start.</h2>
        <div class="strengths">
          <div>
            <h3><a class="link-arrow" href="#" data-mail data-mail-subject="One-off project">One-off project<Icon name="arrow" /></a></h3>
            <p>A defined build, from idea to launch.</p>
          </div>
          <div>
            <h3><a class="link-arrow" href="#" data-mail data-mail-subject="Ongoing work">Ongoing<Icon name="arrow" /></a></h3>
            <p>A longer relationship, building and improving over time.</p>
          </div>
          <div>
            <h3><a class="link-arrow" href="#" data-mail data-mail-subject="Consulting">Consulting<Icon name="arrow" /></a></h3>
            <p>Architecture, reviews and technical leadership.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="contact-band" id="contact">
      <div class="container">
        <div>
          <h2>Have something in mind?</h2>
          <p>Send a short note about what you want built.</p>
        </div>
        <div class="contact-band__actions">
          <Button mail subject="Project" label="Get in touch" icon="mail" />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
