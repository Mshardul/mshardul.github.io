---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../content/projects.ts";
import "../../styles/components/section.css";
---

<BaseLayout title="Things I've built — Shardul Lingwal" description="A curated set of projects, each with its own page and the story behind it.">
  <main class="page-main">
    <div class="pagehead">
      <span class="label">Things I've built</span>
      <h1 class="heading heading--page">Seven things, <span class="highlight">built</span> with care.</h1>
      <p class="lead">A curated set, not every repo. Each one has its own page with the story behind it.</p>
    </div>

    <section class="section section--tone-2">
      <div class="section__inner">
        <div class="project-grid">
          {projects.map((project) => (
            <a class="project-card" href={`/projects/${project.slug}`}>
              <div class="project-card__shot"></div>
              <div class="project-card__body">
                <h3 class="heading heading--item">{project.name}</h3>
                <p class="project-card__text">{project.pitch}</p>
                <div class="tag-list">
                  {project.tags.map((tag) => <span class="tag">{tag}</span>)}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>