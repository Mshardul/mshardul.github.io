---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Section from "../../components/Section.astro";
import { projects } from "../../content/projects.ts";
import { copy } from "../../content/copy.ts";
import { meta } from "../../content/meta.ts";

const { headline } = copy.projects;
---

<BaseLayout title={meta.projects.title} description={meta.projects.description}>
  <main id="main" class="page-main">
    <PageHead label="Things I've built" lead={copy.projects.lead}>
      {headline.before}<span class="highlight">{headline.highlight}</span>{headline.after}
    </PageHead>

    <Section tone={2}>
      <div class="project-grid">
        {projects.map((project) => (
          <ProjectCard {project} level={2} />
        ))}
      </div>
    </Section>
  </main>
</BaseLayout>