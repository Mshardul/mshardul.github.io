---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Section from "../../components/Section.astro";
import { projects } from "../../content/projects.ts";
---

<BaseLayout title="Things I've built — Shardul Lingwal" description="A curated set of projects, each with its own page and the story behind it.">
  <main class="page-main">
    <PageHead label="Things I've built" lead="A curated set, not every repo. Each one has its own page with the story behind it.">
      Seven things, <span class="highlight">built</span> with care.
    </PageHead>

    <Section tone={2}>
      <div class="project-grid">
        {projects.map((project) => (
          <ProjectCard {project} />
        ))}
      </div>
    </Section>
  </main>
</BaseLayout>