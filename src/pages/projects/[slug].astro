---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import Button from "../../components/Button.astro";
import Card from "../../components/Card.astro";
import ChipList from "../../components/ChipList.astro";
import Icon from "../../components/Icon.astro";
import { projects, type Project } from "../../content/projects.ts";
import { nextProject } from "../../lib/projects.ts";
import "../../styles/components/pagehead.css";
import "../../styles/components/section.css";
import "../../styles/components/row.css";
import "../../styles/components/chip.css";
import "../../styles/components/contact-band.css";

export const getStaticPaths = (() => {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props as { project: Project };
const next = nextProject(project.slug);
---

<BaseLayout title={`${project.name} | Shardul Lingwal`} description={project.pitch} current="projects">
  <main id="main" tabindex="-1">
    <PageHead crumb={project.name} lead={project.pitch}>
      {project.name}
      {project.links && project.links.length > 0 && (
        <Fragment slot="after">
          <div class="actions">
            {project.links.map((link) => (
              <Button label={link.label} href={link.href} icon="arrow" />
            ))}
          </div>
        </Fragment>
      )}
    </PageHead>

    <section class="section section--tight-top">
      <div class="container">
        {project.tags.length > 0 && (
            <ChipList items={project.tags.map((t) => ({ label: t }))} small />
        )}
        <div class="rows rows--loose">
          {project.story && (
            <>
              <div class="row row--story">
                <h2>Why I built it</h2>
                <p>{project.story.why}</p>
              </div>
              <div class="row row--story">
                <h2>How it works</h2>
                <p>{project.story.how}</p>
              </div>
              <div class="row row--story">
                <h2>What I learned</h2>
                <p>{project.story.learned}</p>
              </div>
            </>
          )}
          {project.stack && project.stack.length > 0 && (
            <Card panel>
              <h3>Stack</h3>
              <ChipList items={project.stack.map((t) => ({ label: t }))} />
              {project.aiNote && <p class="page-note">{project.aiNote}</p>}
            </Card>
          )}
          <a class="card card--link next-project" href="/coming-soon">
            <small>Next project</small>
            <b>{next.name} <Icon name="arrow" /></b>
          </a>
        </div>
      </div>
    </section>

    <section class="contact-band" id="contact">
      <div class="container">
        <div>
          <h2>Need something like this?</h2>
          <p>Tell me what you want built and I&rsquo;ll tell you how I&rsquo;d approach it.</p>
        </div>
        <div class="contact-band__actions">
          <Button label="Start a project" href="/build-with-me" icon="arrow" />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
