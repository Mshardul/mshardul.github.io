---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Cta from "../../components/Cta.astro";
import Band from "../../components/Band.astro";
import PageHead from "../../components/PageHead.astro";
import Section from "../../components/Section.astro";
import { projects, type Project } from "../../content/projects.ts";
import { nextProject } from "../../lib/projects.ts";
import "../../styles/components/project-detail.css";

export const getStaticPaths = (() => {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props as { project: Project };
const next = nextProject(project.slug);
---

<BaseLayout title={`${project.name} | Shardul Lingwal`} description={project.pitch}>
  <main id="main" class="page-main">
    <PageHead crumb={project.name} lead={project.pitch} tags={project.tags}>
      {project.name}
      <div slot="after">
        {(project.stack?.length || project.aiNote) && (
          <div class="project-meta">
            {project.stack && project.stack.length > 0 && (
              <p class="project-meta__stack"><strong>Stack:</strong> {project.stack.join(", ")}</p>
            )}
            {project.aiNote && <p class="project-meta__note">{project.aiNote}</p>}
          </div>
        )}
        {project.links && project.links.length > 0 && (
          <div class="project-links">
            {project.links.map((link) => (
              <a href={link.href} target="_blank" rel="noopener">{link.label} <span class="visually-hidden">(opens in new tab)</span></a>
            ))}
          </div>
        )}
      </div>
    </PageHead>

    <div class="wrap">
      <div class="bigshot"></div>
    </div>

    {project.story && (
      <Section tone={2}>
        <div class="story">
          <div>
            <h2 class="heading heading--item">Why I built it</h2>
            <p>{project.story.why}</p>
          </div>
          <div>
            <h2 class="heading heading--item">How it works</h2>
            <p>{project.story.how}</p>
          </div>
          <div>
            <h2 class="heading heading--item">What I learned</h2>
            <p>{project.story.learned}</p>
          </div>
        </div>
      </Section>
    )}

    <Section tone={3}>
      <Band heading="Need something like this?" text="Tell me what you're building and we'll take it from there.">
        <Cta primary label="Start a project" mail />
      </Band>
      <div class="next">
        <span>Next project</span>
        <a href={`/projects/${next.slug}`}>{next.name} →</a>
      </div>
    </Section>
  </main>
</BaseLayout>