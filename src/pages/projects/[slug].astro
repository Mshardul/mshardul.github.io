---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Cta from "../../components/Cta.astro";
import { projects, type Project } from "../../content/projects.ts";
import { nextProject } from "../../lib/projects.ts";
import "../../styles/components/section.css";
import "../../styles/components/project-detail.css";

export const getStaticPaths = (() => {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props as { project: Project };
const next = nextProject(project.slug);
---

<BaseLayout title={`${project.name} — Shardul Lingwal`} description={project.pitch}>
  <main class="page-main">
    <div class="pagehead">
      <div class="crumb"><a href="/projects">Things I've built</a> / {project.name}</div>
      <h1 class="heading heading--page">{project.name}, <span class="highlight">made</span> to be used.</h1>
      <p class="lead">{project.pitch}</p>
      <div class="tag-list">
        {project.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>

    <div class="wrap">
      <div class="bigshot"></div>
    </div>

    <section class="section section--tone-2">
      <div class="section__inner">
        <div class="story">
          <div>
            <h2 class="heading heading--item">Why I built it</h2>
            <p>A short paragraph on the problem and what was missing from existing tools.</p>
          </div>
          <div>
            <h2 class="heading heading--item">How it works</h2>
            <p>A short paragraph on the approach, the main pieces and one interesting decision.</p>
          </div>
          <div>
            <h2 class="heading heading--item">What I learned</h2>
            <p>A short paragraph on the trade-offs, surprises and what you'd do differently.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--tone-3">
      <div class="section__inner">
        <div class="band">
          <div>
            <h2 class="heading heading--section">Need something like this?</h2>
            <p class="band__text">Tell me what you're building and we'll take it from there.</p>
          </div>
          <Cta primary label="Start a project" mail />
        </div>
        <div class="next">
          <span>Next project</span>
          <a href={`/projects/${next.slug}`}>{next.name} →</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>