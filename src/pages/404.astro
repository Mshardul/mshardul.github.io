---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { meta } from "../content/meta.ts";
import "../styles/components/pagehead.css";
import "../styles/components/section.css";
---

<BaseLayout title={meta.notFound.title} description={meta.notFound.description}>
  <main id="main" tabindex="-1">
    <section class="not-found">
      <div class="container">
        <p class="eyebrow">404</p>
        <h1>Page not found.</h1>
        <p class="lead">That page does not exist. Try the home page or the projects.</p>
        <div class="actions">
          <Button label="Go home" href="/" />
          <Button label="See projects" href="/projects" variant="ghost" />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
