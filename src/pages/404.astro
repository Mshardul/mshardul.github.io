---
import BaseLayout from "../layouts/BaseLayout.astro";
import Cta from "../components/Cta.astro";
import PageHead from "../components/PageHead.astro";
---

<BaseLayout title="Page not found — Shardul Lingwal" description="That page does not exist.">
  <main class="page-main">
    <PageHead lead="That page does not exist. Try the home page.">
      Page not found.
      <Fragment slot="after">
        <div class="btn-row">
          <Cta primary label="Back home" href="/" />
        </div>
      </Fragment>
    </PageHead>
  </main>
</BaseLayout>