---
import BaseLayout from "../layouts/BaseLayout.astro";
import Cta from "../components/Cta.astro";
import PageHead from "../components/PageHead.astro";
import { copy } from "../content/copy.ts";
import { meta } from "../content/meta.ts";
---

<BaseLayout title={meta.notFound.title} description={meta.notFound.description}>
  <main id="main" class="page-main">
    <PageHead lead={copy.notFound.lead}>
      {copy.notFound.headline}
      <Fragment slot="after">
        <div class="btn-row">
          <Cta primary label="Back home" href="/" />
        </div>
      </Fragment>
    </PageHead>
  </main>
</BaseLayout>