---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TagList from "../components/TagList.astro";
import FactGrid from "../components/FactGrid.astro";
import Band from "../components/Band.astro";
import TimelineRole from "../components/TimelineRole.astro";
import Cta from "../components/Cta.astro";
import Card from "../components/Card.astro";
import { profile } from "../content/profile.ts";
import { roles } from "../content/experience.ts";
import { projects } from "../content/projects.ts";
import { skillGroups } from "../content/skills.ts";
import { education } from "../content/education.ts";
import { about } from "../content/about.ts";
import { copy } from "../content/copy.ts";
import { meta } from "../content/meta.ts";
import { githubUrl, linkedinUrl } from "../lib/contact.ts";
import { hasResume, RESUME_URL } from "../lib/site.ts";
import "../styles/components/skills.css";
import "../styles/components/bio.css";
import "../styles/components/contact.css";
import "../styles/components/blob.css";
---

<BaseLayout title={meta.home.title} description={meta.home.description}>
  <main data-scroll="stack">
    <Section tone={1} id="intro" reveal>
      <span class="label">{profile.role}</span>
      <h1 class="heading heading--hero">{profile.headline}</h1>
      <p class="lead">{profile.summary}</p>
      <div class="btn-row">
        {hasResume && <Cta primary label="Download resume" href={RESUME_URL} />}
        <Cta primary={!hasResume} label="Let's talk" mail />
      </div>
      <FactGrid facts={profile.facts} />
      <div class="blob"></div>
    </Section>

    <Section tone={2} id="experience" heading="Experience" reveal link={{ label: "Full experience →", href: "/experience" }}>
      <div class="timeline">
        {roles.map((role) => (
          <TimelineRole {role} />
        ))}
      </div>
    </Section>

    <Section tone={3} id="built" heading="Things I've built" reveal link={{ label: "All projects →", href: "/projects" }}>
      <div class="project-grid">
        {projects.map((project) => (
          <ProjectCard {project} />
        ))}
      </div>
    </Section>

    <Section tone={4} id="skills" heading="Skills" reveal>
      <div class="skill-grid">
        {skillGroups.map((group) => (
          <div>
            <h4 class="skill-grid__title">{group.title}</h4>
            <TagList items={group.items} />
          </div>
        ))}
      </div>
    </Section>

    <Section tone={1} id="education" heading="Education" reveal>
      {education.map((item) => (
        <Card note={`${item.institution} · ${item.years}`}>
          <h3 class="heading heading--item">{item.degree}</h3>
        </Card>
      ))}
    </Section>

    <Section tone={2} id="about" heading="About" reveal>
      <div class="bio">
        {about.map((paragraph) => (
          <p class="bio__paragraph">{paragraph}</p>
        ))}
      </div>
    </Section>

    <Section tone={3} id="build" reveal>
      <Band heading="Build with me" text={copy.home.buildBandText}>
        <Cta href="/build-with-me" label="See what I build →" primary />
      </Band>
    </Section>

    <Section tone={4} id="contact" heading="Get in touch" reveal>
      <p class="lead">{copy.home.contactLead}</p>
      <div class="contact-list">
        <Cta label="Email" mail />
        <a href={linkedinUrl} target="_blank" rel="noopener">LinkedIn</a>
        <a href={githubUrl} target="_blank" rel="noopener">GitHub</a>
        {hasResume && <a href={RESUME_URL}>Download resume</a>}
      </div>
    </Section>
  </main>
</BaseLayout>